
#include <iostream>
#include <string>
using namespace std;

class Prototype {
public:
    virtual Prototype* clone() = 0;
    virtual void show() = 0;
};
class Employee : public Prototype {
private:
    string name;

public:
    Employee(string n) {
        name = n;
    }

    // Clone method
    Prototype* clone() {
        return new Employee(*this);
    }

    void show() {
        cout << "Employee Name: " << name << endl;
    }
};
int main() {

    Employee e1("John");

    // Clone object
    Prototype* e2 = e1.clone();

    e1.show();
    e2->show();

    return 0;
}
